# Copy to `.env` and adjust for your machine. `.env` is git-ignored.
# These values feed docker-compose. The API reads its connection string from
# backend/src/Ugnay.Api/appsettings*.json (or the ConnectionStrings__Default
# environment variable), which must match the Postgres settings below.

POSTGRES_DB=ugnay
POSTGRES_USER=ugnay
POSTGRES_PASSWORD=ugnay_dev_password
POSTGRES_PORT=5432

ADMINER_PORT=8080

# Used by the EF Core design-time factory (dotnet ef ...). Keep in sync with the above.
UGNAY_DB_CONNECTION=Host=localhost;Port=5432;Database=ugnay;Username=ugnay;Password=ugnay_dev_password
